# ---------- Required ----------
# Public URL of the website (no trailing slash). Used for canonical URLs, sitemaps and structured data.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Long random string used to sign admin sessions.
PAYLOAD_SECRET=change-me-to-a-long-random-string

# ---------- Database ----------
# SQLite (default, zero config):
DATABASE_URL=file:./data/pharma.db
# Postgres (Neon / Supabase / RDS) – recommended for Vercel or multi-instance hosting:
# DATABASE_URL=postgres://user:password@host:5432/dbname

# ---------- Email (optional – inquiry notifications) ----------
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@example.com
# SMTP_FROM_NAME=Pharmadent Remedies

# ---------- Uploads on Vercel (optional) ----------
# BLOB_READ_WRITE_TOKEN=

# ---------- Seed script ----------
# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=ChangeMe123!
